# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:8100

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=stockpulse
DB_PASSWORD=stockpulse_dev
DB_NAME=stockpulse

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Redis (cache + pub/sub + rate limit) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email (AWS SES / Resend / SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StockPulse <no-reply@stockpulse.in>

# ─── Market Data Providers ───────────────────────────────────────────────────
MARKET_DATA_SIMULATE=true
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ALPHA_VANTAGE_API_KEY=
